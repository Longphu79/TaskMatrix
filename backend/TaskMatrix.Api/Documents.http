@baseUrl = http://localhost:5045
@token = replace-with-a-valid-jwt
@documentId = replace-with-a-document-id
@filePath = C:\temp\sample.pdf

### List my documents
GET {{baseUrl}}/api/documents
Authorization: Bearer {{token}}

### Get one document
GET {{baseUrl}}/api/documents/{{documentId}}
Authorization: Bearer {{token}}

### Upload a document
POST {{baseUrl}}/api/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=doc-boundary

--doc-boundary
Content-Disposition: form-data; name="title"

Project plan
--doc-boundary
Content-Disposition: form-data; name="category"

Engineering
--doc-boundary
Content-Disposition: form-data; name="progress"

25
--doc-boundary
Content-Disposition: form-data; name="start"

2026-11-02T09:00:00+07:00
--doc-boundary
Content-Disposition: form-data; name="deadline"

2026-11-16T17:00:00+07:00
--doc-boundary
Content-Disposition: form-data; name="file"; filename="sample.pdf"
Content-Type: application/pdf

< {{filePath}}
--doc-boundary--

### Update document metadata
PUT {{baseUrl}}/api/documents/{{documentId}}
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=doc-boundary

--doc-boundary
Content-Disposition: form-data; name="title"

Updated project plan
--doc-boundary
Content-Disposition: form-data; name="category"

Engineering
--doc-boundary
Content-Disposition: form-data; name="progress"

50
--doc-boundary
Content-Disposition: form-data; name="start"

2026-11-02T09:00:00+07:00
--doc-boundary
Content-Disposition: form-data; name="deadline"

2026-11-16T17:00:00+07:00
--doc-boundary--

### Update progress
PATCH {{baseUrl}}/api/documents/{{documentId}}/progress
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "progress": 75
}

### Download file
GET {{baseUrl}}/api/documents/{{documentId}}/download
Authorization: Bearer {{token}}

### Delete document
DELETE {{baseUrl}}/api/documents/{{documentId}}
Authorization: Bearer {{token}}
